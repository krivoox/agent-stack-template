# Copy to .env.local and fill in. Never commit the filled file.
# Every variable here is declared in src/lib/env.ts — the only file that reads
# process.env. Adding one means editing both.

# ─── Database ────────────────────────────────────────────────────────────────
# Runtime connection. Use the pooled URL when the host offers one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
# Direct, non-pooled connection. Migrations only — a pooler breaks DDL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# At least 32 characters in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical URL. Leave unset on Vercel Preview: the code derives it from
# VERCEL_URL so the CSRF origin check matches the ephemeral deployment.
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated extra CSRF origins, if any.
# BETTER_AUTH_TRUSTED_ORIGINS="https://app.example.com"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# The sign-in button stays hidden unless both are present.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── Development ─────────────────────────────────────────────────────────────
# "1" logs every SQL statement Prisma issues.
PRISMA_LOG_QUERIES="0"

# ─── Scheduled jobs (optional) ───────────────────────────────────────────────
# Bearer token required by /api/cron/* handlers.
# CRON_SECRET=""
